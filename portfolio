<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Sesla — Portfolio</title>
<meta name="description" content="Портфолио Sesla — графический дизайнер, 3D, арт в стиле консоли" />
<style>
  :root{
    --bg:#060606;
    --panel:#0d0d0d;
    --text:#efefef;
    --muted:#9a9a9a;
    --accent:#ffffff;
    --glass: rgba(255,255,255,0.03);
    --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, "Roboto Mono", "Courier New", monospace;
  }
  html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:var(--mono);-webkit-font-smoothing:antialiased;}
  /* Container */
  .wrap{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:32px 24px 80px;box-sizing:border-box;}
  /* Terminal splash */
  #terminalSplash{
    width:min(920px,94%);
    max-width:1200px;
    background:linear-gradient(180deg,var(--panel),rgba(255,255,255,0.02));
    border:1px solid rgba(255,255,255,0.04);
    box-shadow:0 10px 40px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.02);
    border-radius:8px;
    padding:28px;
    margin-top:18vh;
    transform-origin:center;
    overflow:hidden;
  }
  .term-line{color:var(--muted);font-size:14px;display:flex;gap:8px;align-items:center;}
  .term-prompt{color:var(--accent);font-weight:600;}
  .typed{color:var(--text);font-size:20px;white-space:pre;display:inline-block;min-height:28px;}
  .cursor{display:inline-block;width:12px;height:20px;background:var(--text);margin-left:6px;vertical-align:bottom;opacity:1;animation:blink 1s steps(1) infinite;}
  @keyframes blink{50%{opacity:0}}
  /* Close animation target */
  .splash-hide{animation:closeSplash 900ms ease-in-out forwards;}
  @keyframes closeSplash{
    0%{transform:scale(1);opacity:1;height:auto;margin-top:18vh;padding:28px;border-radius:8px}
    70%{transform:scale(.94);opacity:.8}
    100%{transform:scale(.7) translateY(-40px);opacity:0;height:0;margin-top:0;padding:0;border-radius:50%}
  }

  /* Main content (initially hidden) */
  #mainContent{width:min(1200px,96%);max-width:1200px;margin-top:28px;opacity:0;transform:translateY(18px);transition:opacity .6s ease, transform .6s ease;}
  #mainContent.show{opacity:1;transform:none;}
  header{display:flex;align-items:flex-start;gap:20px;padding:18px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);border-radius:8px;border:1px solid rgba(255,255,255,0.02);}
  .hero{
    display:flex;flex-direction:column;gap:6px;flex:1;
  }
  .brand{font-size:18px;color:var(--muted);letter-spacing:1px;}
  h1{margin:0;font-size:42px;color:var(--text);line-height:1.02;}
  .subtitle{color:var(--muted);font-size:14px;margin-top:6px;}
  /* Symbol cursor */
  .symbol-cursor{
    margin-left:6px;
    display:inline-block;
    min-width:28px;
    font-weight:700;
    letter-spacing:1px;
    color:var(--accent);
    background:linear-gradient(90deg, rgba(255,255,255,0.05), transparent);
    padding:4px 8px;
    border-radius:4px;
  }

  /* Gallery */
  .gallery{margin-top:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
  .thumb{
    background:var(--glass);
    border:1px solid rgba(255,255,255,0.03);
    border-radius:6px;
    overflow:hidden;
    position:relative;
    aspect-ratio: 4/3;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s cubic-bezier(.2,.9,.2,1);}
  .thumb:hover img{transform:scale(1.06);}
  .thumb::after{
    content:"";
    position:absolute;inset:0;
    background:linear-gradient(180deg, transparent, rgba(0,0,0,0.2));
    opacity:0;
    transition:opacity .25s;
  }
  .thumb:hover::after{opacity:1;}
  .caption{position:absolute;left:8px;bottom:8px;color:var(--muted);font-size:12px;text-shadow:0 1px 0 rgba(0,0,0,0.6);}
  /* Responsive */
  @media (max-width:1000px){.gallery{grid-template-columns:repeat(3,1fr)} h1{font-size:34px}}
  @media (max-width:700px){.gallery{grid-template-columns:repeat(2,1fr)} header{flex-direction:column;align-items:flex-start}}
  @media (max-width:420px){.gallery{grid-template-columns:repeat(1,1fr)} h1{font-size:26px}}

  /* Lightbox */
  #lightbox{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.85);z-index:60;padding:24px;}
  #lightbox.show{display:flex;}
  #lightbox img{max-width:calc(100% - 80px);max-height:calc(100% - 80px);box-shadow:0 20px 60px rgba(0,0,0,0.8);border-radius:6px;}
  .lb-close{position:fixed;right:28px;top:18px;color:var(--muted);font-size:20px;cursor:pointer;}
  .lb-nav{position:fixed;left:18px;top:50%;transform:translateY(-50%);font-size:28px;color:var(--muted);cursor:pointer;user-select:none}
  .lb-nav.right{left:auto;right:18px}
  .hint{color:var(--muted);font-size:12px;margin-top:8px}

  /* small helper */
  .muted{color:var(--muted);font-size:13px}

  /* placeholder style when image missing */
  .missing{
    display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px;padding:10px;text-align:center;
  }
</style>
</head>
<body>
  <div class="wrap">
    <!-- Terminal splash -->
    <div id="terminalSplash" role="region" aria-label="Запуск терминала">
      <div class="term-line">
        <span class="term-prompt">C:\Users\sesla&gt;</span>
        <div class="typed" id="typedLine" aria-live="polite"></div>
        <span class="cursor" id="fakeCursor" aria-hidden="true"></span>
      </div>
      <div style="height:8px"></div>
      <div class="term-line" style="color:var(--muted);font-size:13px">
        Инициализация… нажмите Esc чтобы пропустить анимацию
      </div>
    </div>

    <!-- Main content (hidden until splash done) -->
    <main id="mainContent" aria-hidden="true">
      <header>
        <div class="hero">
          <div class="brand">@art • off • sesla</div>
          <h1>Sesla — портфолио</h1>
          <div class="subtitle">Графический дизайнер, 3D-моделирование, экспериментальный арт. Навигация — стрелки в лайтбоксе, Esc для закрытия.</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
          <div class="muted">Сверстано в стиле CMD</div>
          <div style="font-size:13px;color:var(--muted)">
            <span id="symbolContainer" class="symbol-cursor" aria-hidden="true"></span>
          </div>
        </div>
      </header>

      <section class="gallery" id="gallery" aria-live="polite" aria-label="Галерея работ">
        <!-- JS will inject thumbnails 1..20 -->
      </section>

      <div style="margin-top:12px;color:var(--muted);display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <div class="muted">Файлы загружай в /images как 1.png — 20.png</div>
      </div>
    </main>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр изображения">
    <div class="lb-close" id="lbClose" title="Закрыть">✕</div>
    <div class="lb-nav left" id="lbPrev" aria-hidden="false" title="Предыдущее">◀</div>
    <div class="lb-nav right" id="lbNext" title="Следующее">▶</div>
    <img id="lbImg" src="" alt="Просмотр работы" />
  </div>

<script>
/* ========== Config ========== */
const TOTAL = 20; // количество работ (1..TOTAL)
const IMAGES_PATH = 'images'; // папка с изображениями
const SYMBOLS = ['@', '+', '#', '%', '*', '<', '~', '>', '?', '!', '\\', '|', '$', '_', '=', ','];
const CMD_STRING = '@art off sesla portfolio';

/* ========== Terminal typewriter ========== */
const typedEl = document.getElementById('typedLine');
const splash = document.getElementById('terminalSplash');
const main = document.getElementById('mainContent');
const fakeCursor = document.getElementById('fakeCursor');

let skip = false;
document.addEventListener('keydown', (e)=>{
  if(e.key === 'Escape') { skip = true; finishSplash(); }
});

/* Type effect */
async function typeString(str, el, speed=60){
  el.textContent = '';
  for(let i=0;i<str.length;i++){
    if(skip) { el.textContent = str; return; }
    el.textContent += str[i];
    await new Promise(r=>setTimeout(r, speed + Math.random()*30));
  }
}

/* Run splash */
(async function runSplash(){
  await typeString(CMD_STRING, typedEl, 55);
  // small pause
  await new Promise(r=>setTimeout(r, 450));
  // animate close
  if(!skip) {
    splash.classList.add('splash-hide');
    await new Promise(r=>setTimeout(r, 750));
  }
  finishSplash();
})();

function finishSplash(){
  // reveal main content
  main.classList.add('show');
  main.setAttribute('aria-hidden','false');
  // ensure splash removed for accessibility
  try{ splash.remove(); }catch(e){}
  // start symbol cursor animation
  startSymbolCursor();
  // populate gallery
  populateGallery();
}

/* ========== Symbol cursor animation ========== */
const symbolContainer = document.getElementById('symbolContainer');
let symbolIndex = 0;
let symbolInterval = null;
function startSymbolCursor(){
  if(symbolInterval) clearInterval(symbolInterval);
  symbolInterval = setInterval(()=>{
    // randomly pick 1..3 symbols to form a cursor art
    const count = 1 + Math.floor(Math.random()*3);
    let s = '';
    for(let i=0;i<count;i++) s += SYMBOLS[Math.floor(Math.random()*SYMBOLS.length)];
    // occasionally add a little flicker
    symbolContainer.textContent = s + (Math.random()>0.7 ? ' ' : '');
  }, 100);
}

/* ========== Gallery generation ========== */
const gallery = document.getElementById('gallery');

function populateGallery(){
  for(let i=1;i<=TOTAL;i++){
    const thumb = document.createElement('figure');
    thumb.className = 'thumb';
    thumb.tabIndex = 0;
    thumb.setAttribute('role','button');
    const img = document.createElement('img');
    img.src = `${IMAGES_PATH}/${i}.png`;
    img.alt = `Работа ${i}`;
    img.loading = 'lazy';
    // if image fails to load, show placeholder
    img.addEventListener('error', ()=>{
      img.style.display = 'none';
      const miss = document.createElement('div');
      miss.className = 'missing';
      miss.textContent = `Нет файла ${i}.png`;
      thumb.appendChild(miss);
    });
    thumb.appendChild(img);

    const cap = document.createElement('figcaption');
    cap.className = 'caption';
    cap.textContent = `#${i}`;
    thumb.appendChild(cap);

    // click to open lightbox
    thumb.addEventListener('click', ()=>openLightbox(i));
    thumb.addEventListener('keydown', (e)=>{ if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(i); } });

    gallery.appendChild(thumb);
  }
}

/* ========== Lightbox ========== */
const lightbox = document.getElementById('lightbox');
const lbImg = document.getElementById('lbImg');
const lbClose = document.getElementById('lbClose');
const lbPrev = document.getElementById('lbPrev');
const lbNext = document.getElementById('lbNext');
let currentIndex = 1;

function openLightbox(index){
  currentIndex = index;
  showImage(index);
  lightbox.classList.add('show');
  document.body.style.overflow = 'hidden';
  // focus close to assist keyboard users
  lbClose.focus();
}

function closeLightbox(){
  lightbox.classList.remove('show');
  document.body.style.overflow = '';
}

function showImage(index){
  lbImg.src = `${IMAGES_PATH}/${index}.png`;
  lbImg.alt = `Работа ${index}`;
}

lbClose.addEventListener('click', closeLightbox);
lbPrev.addEventListener('click', ()=>{ nav(-1); });
lbNext.addEventListener('click', ()=>{ nav(1); });

function nav(dir){
  currentIndex += dir;
  if(currentIndex < 1) currentIndex = TOTAL;
  if(currentIndex > TOTAL) currentIndex = 1;
  showImage(currentIndex);
}

/* Keyboard controls for lightbox */
document.addEventListener('keydown', (e)=>{
  if(lightbox.classList.contains('show')){
    if(e.key === 'ArrowRight') nav(1);
    if(e.key === 'ArrowLeft') nav(-1);
    if(e.key === 'Escape') closeLightbox();
  }
});

/* Click outside image closes */
lightbox.addEventListener('click', (e)=>{
  if(e.target === lightbox) closeLightbox();
});

/* Accessibility: trap focus inside lightbox when open (simple) */
document.addEventListener('focusin', (e)=>{
  if(lightbox.classList.contains('show')){
    if(!lightbox.contains(e.target)) { e.stopPropagation(); lbClose.focus(); }
  }
});

/* small emergency: if images missing show message */
window.addEventListener('load', ()=>{
  // do nothing special; thumbnails will show missing placeholders automatically
});
</script>
</body>
</html>
